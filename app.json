{
  "expo": {
    "assetBundlePatterns": [],

    "name": "MagicHole",
    "slug": "MagicHole",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MagicHole"
    },
    "android": {
      "adaptiveIcon": {
        
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0Tb6iBvl7T92W947KSNqs9gvoSnO2Vzk"
        }
      },
      "package": "com.anonymous.MagicHole"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  "expo-router",
  [
    "expo-splash-screen",
    {
      "resizeMode": "contain",
      "backgroundColor": "#6932a8"
    }
  ],
  "expo-sqlite"
],

    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9a3f423-bf1a-483c-8306-132e962c8071"
      }
    }
  }
}
